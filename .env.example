# Copy to .env and fill in local values. Do not commit .env.

APP_ENV=development
APP_PORT=8000

CONFIG_PATH=./config.yaml
METADATA_SCHEMA_PATH=./metadata_schema.yaml
DOCUMENTS_INPUT_PATH=./documents

# First N blocks per loaded document on the console (0 = summary only)
PREVIEW_BLOCKS=0

# Optional LLM (section classification and metadata extraction). First adapter: Anthropic.
# Leave empty to use alias/rules only; metadata fields stay Unknown.
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5
LLM_API_KEY=

# Chunking sizes (characters of original body; heading prefix is not counted)
# CHUNK_TARGET_SIZE=1000
# CHUNK_MAX_SIZE=1500
# CHUNK_MIN_SIZE=300
# CHUNK_OVERLAP=100

# Metadata extraction (schema path also in config.yaml metadata.schema)
# METADATA_ENABLED=true
# PROCESSING_BATCH_SIZE=50

# Metadata / vector store (provider is interchangeable)
METADATA_STORE_PROVIDER=
METADATA_STORE_URL=
METADATA_STORE_COLLECTION=
METADATA_STORE_API_KEY=

# Processing
PROCESSING_FORCE=false
PROCESSING_OVERWRITE=true
PROCESSING_BATCH_SIZE=50
